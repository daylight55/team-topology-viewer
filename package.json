{
  "name": "team-topology-viewer",
  "version": "1.0.0",
  "description": "B2B SaaS tool for visualizing and optimizing team interactions based on Team Topology",
  "private": true,
  "workspaces": [
    "frontend/*",
    "services/*"
  ],
  "scripts": {
    "dev": "pnpm run docker:up && pnpm run prisma:generate && concurrently -n \"team,interact,gateway,web\" -c \"blue,green,yellow,purple\" \"pnpm run dev:team-service\" \"pnpm run dev:interaction-service\" \"pnpm run dev:gateway\" \"pnpm run dev:web-app\"",
    "dev:team-service": "cd services/team-service && pnpm dev",
    "dev:interaction-service": "cd services/interaction-service && pnpm dev",
    "dev:gateway": "cd services/gateway && pnpm dev",
    "dev:web-app": "cd frontend/web-app && pnpm dev",
    "prisma:generate": "cd services/team-service && pnpm prisma generate && cd ../interaction-service && pnpm prisma generate",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "docker:up": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "db:migrate": "pnpm -r run db:migrate",
    "db:seed": "pnpm -r run db:seed",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.14.0"
}