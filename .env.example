# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.team-topology-viewer.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_ADMIN_CLIENT_ID=your-admin-client-id

# Database Configuration
DATABASE_URL=postgresql://ttv_user:ttv_password@localhost:5432/ttv_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# RabbitMQ Configuration
RABBITMQ_URL=amqp://ttv_user:ttv_password@localhost:5672

# Service URLs (for local development)
GATEWAY_URL=http://localhost:4000
TEAM_SERVICE_URL=http://localhost:3001
INTERACTION_SERVICE_URL=http://localhost:3002
ANALYTICS_SERVICE_URL=http://localhost:3003
USER_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Frontend URLs
WEB_APP_URL=http://localhost:3000
ADMIN_PANEL_URL=http://localhost:3100

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=debug

# Monitoring
ENABLE_TRACING=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces